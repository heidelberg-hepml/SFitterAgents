# Copy to config.env and fill in. For the launcher the precedence is
# caller env > config.env > defaults, so any value here can be overridden for a
# single launch:
#   APPTAINER_IMAGE=/shared/sfitteragents.sif ./sfitteragents.sh
# (image/create_image.sh sources this file over the caller's environment.)
# Relative paths resolve against the repository root. config.env is git-ignored.

# Directory containing the `apptainer` binary. Empty: look on PATH.
APPTAINER_DIR=""

# Claude Code config dir (login, settings, conversation transcripts), mounted into
# the container. Empty (recommended): claude_config/ in this repository — log in
# once in the first session. Pointing it at your own ~/.claude reuses that login,
# but also brings your personal settings, hooks and agents into the sessions and
# lets the agents modify them.
CLAUDE_CONFIG_DIR=""

# Runtime image: a sandbox directory or a .sif. Empty: image/sfitteragents_sandbox/
# if it exists, else image/sfitteragents.sif (both built by image/create_image.sh).
# Cluster jobs run this image by the same path, so compute nodes must see it.
APPTAINER_IMAGE=""

# Writable overlay. Empty (recommended): every launch gets a fresh directory overlay
# under OVERLAY_BASE, removed on exit — all durable state is mounted from the session.
# Set it to use one fixed overlay (a directory or an ext3 .img) instead; launches
# sharing one overlay must not run at the same time.
APPTAINER_OVERLAY=""

# Local-disk directory for the per-launch overlays (each is created private to you,
# under an unpredictable name). It must support overlayfs, which a network
# filesystem (NFS, Lustre, ...) does not. Empty: the system temp dir (e.g. /tmp).
OVERLAY_BASE=""

# SLURM passthrough. Empty or "auto": bind the host's SLURM config and auth socket
# when this host is a SLURM submit host. "0": never. "1": required — a host without
# SLURM is a launch error.
BIND_SLURM=""

# Shared scratch for cluster jobs; compute nodes must see it under the same path.
# Empty: sessions/<id>/cluster_runs/ (fine when this repository is on shared storage).
# Set: <CLUSTER_RUNS_BASE>/<session id>/.
CLUSTER_RUNS_BASE=""

# Apptainer's own cache and temp dirs, passed through to apptainer (e.g. node-local disk).
# APPTAINER_CACHEDIR=""
# APPTAINER_TMPDIR=""

# --- Image build (image/create_image.sh) ---
# Another SFitter checkout to install instead of ./sfitter.
SFITTER_SRC=""
# 1: build only image/sfitteragents_sandbox/ (skips the .sif and mksquashfs).
IMAGE_SANDBOX_ONLY="0"

# No API keys: Claude Code authenticates itself (subscription or API credits) through
# CLAUDE_CONFIG_DIR, and the launcher strips *_API_KEY / *_AUTH_TOKEN variables and
# CLAUDE_CODE_OAUTH_TOKEN from the container environment.
